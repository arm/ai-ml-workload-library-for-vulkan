OpCapability Shader
OpMemoryModel Logical GLSL450
OpEntryPoint GLCompute %main "main" %output %push
OpExecutionMode %main LocalSize 1 1 1
OpDecorate %Output Block
OpMemberDecorate %Output 0 Offset 0
OpDecorate %output DescriptorSet 0
OpDecorate %output Binding 0
OpDecorate %Push Block
OpMemberDecorate %Push 0 Offset PUSH_CONSTANT_OFFSET
%void = OpTypeVoid
%function = OpTypeFunction %void
%int = OpTypeInt 32 1
%zero = OpConstant %int 0
%Output = OpTypeStruct %int
%outputPtr = OpTypePointer StorageBuffer %Output
%outputIntPtr = OpTypePointer StorageBuffer %int
%output = OpVariable %outputPtr StorageBuffer
%Push = OpTypeStruct %int
%pushPtr = OpTypePointer PushConstant %Push
%pushIntPtr = OpTypePointer PushConstant %int
%push = OpVariable %pushPtr PushConstant
%main = OpFunction %void None %function
%entry = OpLabel
%source = OpAccessChain %pushIntPtr %push %zero
%value = OpLoad %int %source
%destination = OpAccessChain %outputIntPtr %output %zero
OpStore %destination %value
OpReturn
OpFunctionEnd
